<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  Install to /etc/avahi/services/stratoscan.service (#76).

  Lets the phone app find this radar on the home network again after the
  router gives it a new address: the app browses for _stratoscan._tcp, then
  asks each radar it finds for its unit id through the LAN-only
  /setup/api/hello, and keeps the one it is paired with
  (ios/StratoScan/Pairing/RadarFinder.swift). No TXT record: nothing here is
  needed to tell radars apart, and nothing secret is advertised.
-->
<service-group>
  <name replace-wildcards="yes">StratoScan on %h</name>
  <service>
    <type>_stratoscan._tcp</type>
    <port>80</port>
  </service>
</service-group>
