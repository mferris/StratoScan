[Unit]
Description=FlightRadar setup web server (unprivileged)
After=flightradar-setupd.service
Wants=flightradar-setupd.service

[Service]
# Deliberately NOT root. Everything privileged goes through the unix socket
# to setupd.py, which re-validates every parameter. This process only parses
# HTTP -- the part most exposed to hostile input.
User=frsetup
Group=frsetup
ExecStart=/usr/bin/python3 /opt/flightradar/setup-server.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
StateDirectory=flightradar-setup
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
