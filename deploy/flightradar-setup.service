[Unit]
Description=FlightRadar setup web server (unprivileged)
After=flightradar-setupd.service
Wants=flightradar-setupd.service

[Service]
# Deliberately NOT root. Everything privileged goes through the unix socket
# to setupd.py, which re-validates every parameter. This process only parses
# HTTP -- the part most exposed to hostile input.
User=frsetup
Group=frsetup
ExecStart=/usr/bin/python3 /opt/flightradar/setup-server.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# AF_NETLINK is required: without it the process cannot enumerate network
# interfaces, so it cannot tell the recipient which address to open the setup
# page on. This only shows up under the real sandbox -- running the same code
# by hand as the same user works fine, which is a good way to be misled.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
StateDirectory=flightradar-setup
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
