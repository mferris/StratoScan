[Unit]
Description=FlightRadar setup root helper (privileged verb server)
After=network.target NetworkManager.service
# StartLimitIntervalSec belongs in [Unit], not [Service]. Sitting in the
# wrong section it was silently ignored, so the start-limit exemption
# this recovery-critical unit is meant to have was never in effect: five
# quick restarts would still have bricked it permanently.
StartLimitIntervalSec=0

[Service]
# Root by necessity: it drives nmcli, tailscale, systemctl and rewrites
# /etc/default/readsb. It has no network listener of its own -- only a unix
# socket -- so the attack surface is the verb enum, not an HTTP parser.
User=root
Environment=SETUP_GROUP=frsetup
ExecStart=/usr/bin/python3 /opt/flightradar/setupd.py
Restart=always
RestartSec=5
RuntimeDirectory=flightradar
RuntimeDirectoryMode=0750
# Deliberately NO StateDirectory here. Both units used to declare it, and
# whichever started last decided the ownership -- root:0700 locked the
# unprivileged web tier out of its own state file, so the device reported
# itself unclaimed and the owner's real password stopped working. The web
# tier's unit owns the directory; root can write it regardless.

[Install]
WantedBy=multi-user.target
