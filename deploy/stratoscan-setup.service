[Unit]
Description=StratoScan setup web server (unprivileged)
After=stratoscan-setupd.service
Wants=stratoscan-setupd.service
# StartLimitIntervalSec belongs in [Unit], not [Service]. Sitting in the
# wrong section it was silently ignored, so the start-limit exemption
# this recovery-critical unit is meant to have was never in effect: five
# quick restarts would still have bricked it permanently.
StartLimitIntervalSec=0

[Service]
# Deliberately NOT root. Everything privileged goes through the unix socket
# to setupd.py, which re-validates every parameter. This process only parses
# HTTP -- the part most exposed to hostile input.
User=scsetup
Group=scsetup
ExecStart=/usr/bin/python3 /opt/stratoscan/setup-server.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# AF_NETLINK is required: without it the process cannot enumerate network
# interfaces, so it cannot tell the recipient which address to open the setup
# page on. This only shows up under the real sandbox -- running the same code
# by hand as the same user works fine, which is a good way to be misled.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
StateDirectory=stratoscan-setup
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
