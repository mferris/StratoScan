[Unit]
Description=StratoScan network watchdog (rollback + setup hotspot fallback)
After=NetworkManager.service stratoscan-setupd.service
Wants=stratoscan-setupd.service

# StartLimitIntervalSec belongs to [Unit], not [Service] -- systemd logged
# "Unknown key 'StartLimitIntervalSec' in section [Service], ignoring" on
# every start, so the rate-limit exemption this was meant to grant was never
# actually in effect. This unit is the recovery path and must never be
# rate-limited into permanent failure.
StartLimitIntervalSec=0

[Service]
# Long-running since 2026-10-08 (security review item 4): it keeps its own
# two-minute cadence, so systemd no longer logs a start and a finish every
# run. It replaced stratoscan-netwatchdog.timer, which the installer removes.
Type=simple
ExecStart=/usr/bin/python3 /opt/stratoscan/net-watchdog.py --loop
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
