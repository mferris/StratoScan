# StratoScan's boot splash script, installed over Raspberry Pi OS's
# /usr/share/plymouth/themes/pix/pix.script (diverted, like splash.png, by
# deploy/quiet-boot.sh). It draws the picture, centred on the picture's own
# background colour, and nothing else: the original also printed systemd's
# start-up messages along the bottom of the screen.
bg_r = 10 / 255; bg_g = 13 / 255; bg_b = 15 / 255;    # #0a0d0f, as splash.png
Window.SetBackgroundTopColor(bg_r, bg_g, bg_b);
Window.SetBackgroundBottomColor(bg_r, bg_g, bg_b);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
image = Image("splash.png");
scale = Math.Min(screen_width / image.GetWidth(), screen_height / image.GetHeight());
if (scale < 1)
  image = image.Scale(image.GetWidth() * scale, image.GetHeight() * scale);
sprite = Sprite(image);
sprite.SetPosition((screen_width - image.GetWidth()) / 2, (screen_height - image.GetHeight()) / 2, -100);
