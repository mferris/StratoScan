[Unit]
Description=FlightRadar Chromium Kiosk
After=graphical-session.target

[Service]
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 60 ]; do ls "$XDG_RUNTIME_DIR"/wayland-*[0-9] >/dev/null 2>&1 && exit 0; sleep 1; i=$((i+1)); done; exit 1'
# The HTTP cache lives in the runtime dir (tmpfs), not ~/.cache on the SD
# card: storm and lightning tiles are re-fetched every few minutes forever,
# and that churn was ~1 GB/day of card writes. The profile itself stays on
# disk -- it holds the settings (localStorage) that must survive a reboot.
ExecStart=/usr/bin/chromium --disk-cache-dir=%t/chromium-cache --disk-cache-size=104857600 --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disable-restore-session-state --check-for-update-interval=31536000 --overscroll-history-navigation=0 --disable-pinch --password-store=basic --disable-features=TranslateUI --autoplay-policy=no-user-gesture-required "http://localhost/index.html?kiosk=1"
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
