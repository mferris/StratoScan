[Unit]
Description=StratoScan update check (verifies signatures; installs nothing)
Documentation=https://github.com/mferris/StratoScan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
StateDirectory=stratoscan-ota
# CHECK ONLY. This looks for a newer signed release and records what it found;
# it never installs. Applying is a deliberate act by whoever owns the device,
# from the settings screen or the setup page -- a unit that silently replaced
# its own software overnight would be a very different thing to give somebody.
ExecStart=/opt/stratoscan/ota.py check
# A oneshot has no start limit of its own (#86, 2026-10-26): a check that
# hung kept the unit active and every later timer firing was skipped.
TimeoutStartSec=5min
