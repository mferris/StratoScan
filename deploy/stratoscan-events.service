[Unit]
Description=StratoScan unit events for paired phones (emergency, notable, low, helicopter)
Documentation=https://github.com/mferris/StratoScan
After=network-online.target readsb.service

[Service]
ExecStart=/usr/bin/python3 /opt/stratoscan/events.py run
Restart=always
RestartSec=10
# Its own user since 2026-10-08 (security review item 1): it reads the unit
# key through the stratoscan-relay group (/var/lib/stratoscan-relay is
# root:stratoscan-relay 0750, the key 0640; the installer and heartbeat.py
# keep it so) and can write only its own runtime directory. It holds no
# capabilities and only ever makes outbound HTTPS requests.
User=stratoscan-events
Group=stratoscan-events
SupplementaryGroups=stratoscan-relay
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RuntimeDirectory=stratoscan-events
# Keeps what was already reported across a restart (events.py FIRED).
RuntimeDirectoryPreserve=restart
MemoryMax=150M
Nice=5

[Install]
WantedBy=multi-user.target
