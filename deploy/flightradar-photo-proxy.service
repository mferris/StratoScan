[Unit]
Description=FlightRadar aircraft photo proxy (planespotters.net)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/flightradar/photo-proxy.py
Restart=always
RestartSec=5
# 127.0.0.1-only listener; no elevated privileges needed
DynamicUser=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
