[Unit]
Description=StratoScan network comparison proxy (local-only)
After=network-online.target lighttpd.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/stratoscan/network-compare.py
Restart=always
RestartSec=5
# 127.0.0.1-only listener, same as the other stores. DynamicUser rather than
# a named account: an earlier draft specified User=stratoscan, which does
# not exist on this image and would simply have failed to start.
DynamicUser=yes
# May read the unit key (root:stratoscan-relay 0640, heartbeat.py), as the
# events service does: the view beyond the ring comes through the relay's shared
# cache, and the relay serves only requests the unit has signed (2026-10-09).
# Without the group the service cannot see the key and quietly asks the
# public services itself, which is the fallback, not a failure.
SupplementaryGroups=stratoscan-relay
NoNewPrivileges=yes
StateDirectory=stratoscan-network
# Unlike the other stores this one makes an OUTBOUND request, so it needs
# AF_INET/AF_INET6 -- and nothing else. AF_NETLINK is deliberately absent;
# it is only needed by services that enumerate interfaces, and leaving it
# out is what keeps this from being able to inspect the network stack.
RestrictAddressFamilies=AF_INET AF_INET6
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
