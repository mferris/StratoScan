[Unit]
Description=StratoScan display blanking (idle -> panel off)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# swayidle watches the compositor's idle state; wlopm powers the output
# itself down, which is the only real "off" available here -- this Pi has
# no backlight control (/sys/class/backlight is empty), so darkening pixels
# in the page leaves the backlight lit. Touching the panel is ordinary
# input, so `resume` fires and the display comes straight back.
#
# IDLE_MINUTES: how long the panel stays lit after the last touch.
# wake-listener.py reads it from here and enforces it itself (2026-10-17):
# swayidle's timer counts from the desktop's last activity, and every sound
# the page plays is activity, so it is only the backstop now.
# ALERT_HOLD_S: how long it stays lit when an ALERT turned it on and nobody
# has touched it since (2026-10-10). Every alert used to give a fresh 20
# minutes, and the radar alerts every few minutes in the day, so the panel
# never went dark (168 wakes in one day). wake-listener.py marks an alert
# wake with the flag file below; the ALERT_HOLD_S timeout turns the panel
# off only while the flag is there; any input clears it (resume runs after
# the 1-second timeout, i.e. on the first touch after a pause), so a touch
# gets the ordinary IDLE_MINUTES.
#
# The resume MUST follow `timeout 1 true`: swayidle ties each resume to the
# timeout just before it. Until 2026-10-11 it followed the IDLE_MINUTES
# timeout, so a touch woke the panel only after a 20-minute idle. A panel
# switched off by the alert hold, or by quiet hours, stayed dark under the
# owner's finger. Wakes that are not alerts (an update
# waiting to verify its paint) set no flag and keep the full time.
# Edit either and
#   systemctl --user restart stratoscan-screensaver.service
Environment=IDLE_MINUTES=20
Environment=ALERT_HOLD_S=120
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 60 ]; do ls "$XDG_RUNTIME_DIR"/wayland-*[0-9] >/dev/null 2>&1 && exit 0; sleep 1; i=$((i+1)); done; exit 1'
# The alert hold's backstop clears its flag and acts only on a lit panel: a
# listener restarted in the middle of a hold left the flag behind, and the
# backstop then logged an "off" for a panel already dark (2026-10-18).
# Each change is logged (journalctl -t stratoscan-screen), so the hours the
# panel is lit can be counted rather than guessed (2026-10-10).
# `resume` is screen-resume.sh (2026-10-16): the desktop also reports
# activity while Chromium plays a sound, and the script lights the panel, and
# ends an alert's hold, only for real input (wake-listener.py notes it).
# The script finds the compositor itself when the session had not yet
# published WAYLAND_DISPLAY: after a boot this service can start first, and
# swayidle still connects (libwayland falls back to wayland-0) but every
# wlopm call fails with "WAYLAND_DISPLAY is not set", so the panel never went
# dark (RDU, 2026-10-16 13:40 to the next morning). wake-listener.py does the
# same (2026-10-11).
ExecStart=/bin/sh -c '[ -n "$${WAYLAND_DISPLAY}" ] || export WAYLAND_DISPLAY="$$(basename "$$(ls -d "$XDG_RUNTIME_DIR"/wayland-*[0-9] | head -n 1)")"; F="$XDG_RUNTIME_DIR/stratoscan-alert-wake"; exec swayidle -w timeout 1 true resume /opt/stratoscan/screen-resume.sh timeout "$ALERT_HOLD_S" "[ -e $$F ] && rm -f $$F && wlopm | grep -q \\" on\\" && wlopm --off \\* && logger -t stratoscan-screen off-after-alert" timeout $((IDLE_MINUTES * 60)) "wlopm | grep -q \\" on\\" && wlopm --off \\* && logger -t stratoscan-screen off-idle"'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
