[Unit]
Description=StratoScan shared-memory guard (restarts the kiosk before /dev/shm fills)
Documentation=https://github.com/mferris/StratoScan

[Service]
Type=oneshot
StateDirectory=stratoscan-shmguard
# A oneshot with no timeout waits forever: one hung compositor call used to
# leave this unit 'activating' for good, and its timer never fired again --
# silently disabling the leak guard.
TimeoutStartSec=5min
ExecStart=/opt/stratoscan/shm-guard.sh
