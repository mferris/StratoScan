[Unit]
Description=Apply FlightRadar updates once a day

[Timer]
# Evening rather than the small hours. The update has to see a painted frame
# to verify itself, and at 04:00 the panel is blanked by design -- the same
# reason the kiosk restart runs then is the reason this must not.
OnCalendar=*-*-* 19:00:00
# Three hours of jitter: every unit asking GitHub at 19:00 would arrive
# together, and they are all the same repo.
RandomizedDelaySec=3h
Persistent=true

[Install]
WantedBy=timers.target
