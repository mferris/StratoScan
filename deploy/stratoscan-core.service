[Unit]
Description=StratoScan core feed: one labelled aircraft list for every screen (roadmap 1.8)
After=network-online.target lighttpd.service readsb.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/stratoscan/core-feed.py
Restart=always
RestartSec=5
# 127.0.0.1-only listener, like the other stores. It reads readsb's files and
# the notable list, and makes outbound HTTPS requests for routes and owners,
# so it needs AF_INET/AF_INET6 and nothing else. No state on disk: its caches
# are in memory, which also keeps it off the SD card.
DynamicUser=yes
# May read the unit key (root:stratoscan-relay 0640, heartbeat.py), as the
# events service does: routes and owners come through the relay's shared
# cache, and the relay serves only requests the unit has signed (2026-10-09).
# Without the group the service cannot see the key and quietly asks the
# public services itself, which is the fallback, not a failure.
SupplementaryGroups=stratoscan-relay
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
