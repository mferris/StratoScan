[Unit]
Description=StratoScan Funnel-facing filtering proxy (rounds receiver.json's coordinates)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/stratoscan/funnel-gateway.py
Restart=always
RestartSec=5
# 127.0.0.1-only listener; no elevated privileges needed
DynamicUser=yes
NoNewPrivileges=yes
# Visitor counts (roadmap 1.12): counts only, kept 90 days. Without this the
# gateway still counts, in memory, and starts from zero when it restarts.
StateDirectory=stratoscan-visits

[Install]
WantedBy=default.target
