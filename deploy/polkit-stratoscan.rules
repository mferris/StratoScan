// StratoScan: package changes, the clock and the network need an
// administrator.
//
// Installed as /etc/polkit-1/rules.d/05-stratoscan.rules by
// deploy/install-setup-server.sh. polkit reads every rules file in name
// order across /etc/polkit-1/rules.d and /usr/share/polkit-1/rules.d, and
// the first rule to answer wins, so 05- comes before Raspberry Pi OS's 10-
// rules and NetworkManager's own.
//
// Why (security review 2026-11-03, SR-12 and SR-39): Raspberry Pi OS's
// gui-pkinst, gui-updater and rp-prefapps rules let any member of the sudo
// group install, remove or upgrade packages through PackageKit with no
// password, on the strength of a command line the caller chooses; and they
// let ANY user stop or start systemd-timesyncd. On a radar the kiosk's user
// is in the sudo group, so code running as it could have removed sshd or
// lighttpd, or pulled in the Chromium and kernel the releases hold back.
//
// NetworkManager's rule, and its defaults for an active local session, let
// the same user add, change and bring up network profiles with no password:
// join the radar to another WiFi network, or share one, which the on-screen
// setup asks the admin password for (SR-11). Everything but a scan needs an
// administrator here too.
//
// Nothing on a radar uses PackageKit, or NetworkManager through polkit, as
// anyone but root. Packages change only as root (unattended-upgrades,
// os-update.py, the installer); the network is changed by setupd and
// net-watchdog, both root, and the panel's WiFi and hotspot go through
// setupd. polkit always allows root, so this rule leaves root to the rules
// after it. AUTH_ADMIN asks for an administrator's password: the desktop's
// polkit agent shows a prompt on the screen, and with no agent, or no
// answer, it is a refusal.
polkit.addRule(function (action, subject) {
    if (subject.user == "root") {
        return undefined;
    }
    if (action.id.indexOf("org.freedesktop.packagekit.") == 0) {
        return polkit.Result.AUTH_ADMIN;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "systemd-timesyncd.service") {
        return polkit.Result.AUTH_ADMIN;
    }
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0 &&
        action.id != "org.freedesktop.NetworkManager.wifi.scan") {
        return polkit.Result.AUTH_ADMIN;
    }
    return undefined;
});
