*.log
.DS_Store

# Local Claude Code permission allowlist -- machine-specific, nothing sensitive,
# just not meaningfully portable. .claude/launch.json (dev-server preview
# config) is intentionally tracked, not ignored.
.claude/settings.local.json

# iOS
ios/build/
ios/**/xcuserdata/
ios/**/*.xcuserdatad/

# Release build output: bundles, manifests and signatures are published
# to GitHub Releases, never committed. Signing is a local act.
dist/

# Built per-unit by deploy/offline-map.py; never committed.
offline-map/
offline-map.new/
offline-map.old/

# relay/ build dependencies
relay/node_modules/
relay/.wrangler/
relay/.dev.vars
data/

# The relay's real deployment config is the maintainer's; start from relay/wrangler.example.toml
relay/wrangler.toml

# The maintainer's Apple team ID (see ios/Config/Signing.xcconfig)
ios/Config/Team.xcconfig

# The local radar dev-server.py proxies to (one line, e.g. http://raspberrypi.local)
.dev-pi
